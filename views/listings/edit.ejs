<% layout("layouts/boilerplate") -%>
    <div class="row mt-3">
        <div class="col-8 offset-3">
            <h3>Edit your Listing</h3>

            <form class="needs-validation" method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate enctype="multipart/form-data">
                <div class="mb-2">
                    <label for="title" class="form-label">Title</label>
                    <input class="form-control" type="text" name="listing[title]" value="<%= listing.title %>" required>
                    <div class="valid-feedback">Title Badhiya Hai Bhai!!</div>
                    <div class="invalid-feedback">Galat title diye ho achha title do</div>
                </div>
                <div class="mb-2">
                    <label for="description" class="form-label">Description</label>
                    <textarea class="form-control" name="listing[description]" required><%= listing.description %></textarea>
                    <div class="invalid-feedback">Please Enter Valid Description</div>
                </div>
                <div class="mb-3">
                    Original Listing Image <br>
                    <img src="<%= originalImageUrl %>" alt="listing_image" style="width: 450px; height: 350px; object-fit: cover; border-radius: 8px;">
                </div>

                <div class="mb-2">
                    <label for="image" class="form-label">Upload New Image</label>
                    <input class="form-control" type="file" name="listing[image]">
                    <div class="invalid-feedback">Please Enter Valid URL/Link</div>
                </div>
                <div class="row">
                    <div class="mb-2 col-md-4">
                        <label for="price" class="form-label">Price</label>
                        <input class="form-control" type="number" name="listing[price]" value="<%= listing.price %>" required>
                        <div class="invalid-feedback">Accha price rakho yarr!!</div>
                    </div>
                    <div class="mb-2 col-md-8">
                        <label for="country" class="form-label">Country</label>
                        <input class="form-control" type="text" name="listing[country]" value="<%= listing.country %>" required>
                        <div class="invalid-feedback">Sahi Country fill kro!!!</div>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="location" class="form-label">Location</label>
                    <input class="form-control" type="text" name="listing[location]" value="<%= listing.location %>" required>
                    <div class="invalid-feedback">Location Correct nhi hai!!!</div>
                </div>
                <button class="btn btn-dark edit-btn mt-3">Edit</button>
            </form>
        </div>
    </div>
    